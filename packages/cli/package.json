{
  "name": "bastion-scan",
  "version": "0.2.2",
  "description": "Privacy-first security checker for web projects. Zero data uploaded, actionable fixes.",
  "type": "module",
  "bin": {
    "bastion": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "security",
    "scanner",
    "cli",
    "owasp",
    "privacy",
    "devtools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absastreon/bastion.git"
  },
  "homepage": "https://bastion.wiki",
  "author": "ABS Astreon",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --root ../..",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.3.0",
    "semver": "^7.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@bastion/shared": "*",
    "@types/semver": "^7.7.1",
    "tsup": "^8.0.0"
  }
}
